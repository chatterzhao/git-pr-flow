#!/bin/bash
# GPF GitHub操作层 - 纯GitHub CLI命令执行，无业务逻辑
# 提供安全的GitHub CLI操作原语，包含错误处理和重试机制

set -euo pipefail

# ==============================================================================
# GitHub操作层 - 核心原语
# ==============================================================================

# GitHub PR创建操作
github_pr_create_operation() {
    local title="$1"
    local body="$2"
    local head_branch="$3"
    local base_branch="$4"
    local worktree_path="${5:-$(pwd)}"
    local draft_mode="${6:-false}"
    
    # 前置安全检查
    [[ -n "$title" && -n "$head_branch" && -n "$base_branch" ]] || {
        echo "❌ 错误：PR标题、源分支和目标分支不能为空" >&2
        return 1
    }
    
    # 验证GitHub CLI可用性
    if ! command -v gh >/dev/null 2>&1; then
        echo "❌ 错误：GitHub CLI (gh) 未安装" >&2
        return 1
    fi
    
    # 验证GitHub认证
    if ! gh auth status >/dev/null 2>&1; then
        echo "❌ 错误：GitHub CLI 未认证" >&2
        return 1
    fi
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    }
    
    # 检查是否在Git仓库中
    if ! git -C "$worktree_path" rev-parse --git-dir >/dev/null 2>&1; then
        echo "❌ 错误：不是有效的Git仓库: $worktree_path" >&2
        return 1
    fi
    
    # 构造gh pr create参数
    local pr_args=("pr" "create")
    pr_args+=("--title" "$title")
    pr_args+=("--head" "$head_branch")
    pr_args+=("--base" "$base_branch")
    
    [[ -n "$body" ]] && pr_args+=("--body" "$body")
    [[ "$draft_mode" == "true" ]] && pr_args+=("--draft")
    
    # 执行PR创建操作
    local pr_output
    if pr_output=$(gh -C "$worktree_path" "${pr_args[@]}" 2>&1); then
        echo "✅ 成功创建PR: $head_branch → $base_branch"
        
        # 提取PR URL
        local pr_url
        pr_url=$(echo "$pr_output" | grep -E "https://github.com/.*/pull/[0-9]+" | head -1)
        [[ -n "$pr_url" ]] && echo "🔗 PR链接: $pr_url"
        
        return 0
    else
        echo "❌ 创建PR失败" >&2
        echo "$pr_output" >&2
        return 1
    fi
}

# GitHub PR合并操作
github_pr_merge_operation() {
    local pr_number="$1"
    local merge_method="${2:-merge}"  # merge/squash/rebase
    local worktree_path="${3:-$(pwd)}"
    local delete_branch="${4:-false}"
    
    # 前置安全检查
    [[ -n "$pr_number" ]] || {
        echo "❌ 错误：PR编号不能为空" >&2
        return 1
    }
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    }
    
    # 验证合并方法
    case "$merge_method" in
        "merge"|"squash"|"rebase") ;;
        *)
            echo "❌ 错误：无效的合并方法: $merge_method" >&2
            return 1
            ;;
    esac
    
    # 检查PR状态
    local pr_state
    pr_state=$(gh -C "$worktree_path" pr view "$pr_number" --json state -q '.state' 2>/dev/null)
    if [[ "$pr_state" != "OPEN" ]]; then
        echo "❌ 错误：PR #$pr_number 状态为 $pr_state，无法合并" >&2
        return 1
    fi
    
    # 构造合并参数
    local merge_args=("pr" "merge" "$pr_number")
    case "$merge_method" in
        "squash") merge_args+=("--squash") ;;
        "rebase") merge_args+=("--rebase") ;;
        "merge") merge_args+=("--merge") ;;
    esac
    [[ "$delete_branch" == "true" ]] && merge_args+=("--delete-branch")
    
    # 执行合并操作
    if gh -C "$worktree_path" "${merge_args[@]}" >/dev/null 2>&1; then
        echo "✅ 成功合并PR #$pr_number (方法: $merge_method)"
        return 0
    else
        echo "❌ 合并PR失败: #$pr_number" >&2
        return 1
    fi
}

# GitHub PR关闭操作
github_pr_close_operation() {
    local pr_number="$1"
    local worktree_path="${2:-$(pwd)}"
    local close_comment="${3:-}"
    
    # 前置安全检查
    [[ -n "$pr_number" ]] || {
        echo "❌ 错误：PR编号不能为空" >&2
        return 1
    }
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    }
    
    # 构造关闭参数
    local close_args=("pr" "close" "$pr_number")
    [[ -n "$close_comment" ]] && close_args+=("--comment" "$close_comment")
    
    # 执行关闭操作
    if gh -C "$worktree_path" "${close_args[@]}" >/dev/null 2>&1; then
        echo "✅ 成功关闭PR #$pr_number"
        return 0
    else
        echo "❌ 关闭PR失败: #$pr_number" >&2
        return 1
    fi
}

# GitHub PR更新操作
github_pr_update_operation() {
    local pr_number="$1"
    local worktree_path="${2:-$(pwd)}"
    local update_options="${3:-}"  # JSON格式的更新选项
    
    # 前置安全检查
    [[ -n "$pr_number" ]] || {
        echo "❌ 错误：PR编号不能为空" >&2
        return 1
    }
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    fi
    
    # 解析更新选项
    local new_title new_body add_labels remove_labels
    if [[ -n "$update_options" ]]; then
        new_title=$(echo "$update_options" | jq -r '.title // empty' 2>/dev/null)
        new_body=$(echo "$update_options" | jq -r '.body // empty' 2>/dev/null)
        add_labels=$(echo "$update_options" | jq -r '.add_labels[]? // empty' 2>/dev/null | tr '\n' ',' | sed 's/,$//')
        remove_labels=$(echo "$update_options" | jq -r '.remove_labels[]? // empty' 2>/dev/null | tr '\n' ',' | sed 's/,$//')
    fi
    
    # 构造更新参数
    local edit_args=("pr" "edit" "$pr_number")
    [[ -n "$new_title" ]] && edit_args+=("--title" "$new_title")
    [[ -n "$new_body" ]] && edit_args+=("--body" "$new_body")
    [[ -n "$add_labels" ]] && edit_args+=("--add-label" "$add_labels")
    [[ -n "$remove_labels" ]] && edit_args+=("--remove-label" "$remove_labels")
    
    # 检查是否有更新内容
    if [[ ${#edit_args[@]} -eq 3 ]]; then
        echo "⚠️ 警告：没有指定更新内容，跳过PR更新"
        return 0
    fi
    
    # 执行更新操作
    if gh -C "$worktree_path" "${edit_args[@]}" >/dev/null 2>&1; then
        echo "✅ 成功更新PR #$pr_number"
        return 0
    else
        echo "❌ 更新PR失败: #$pr_number" >&2
        return 1
    fi
}

# GitHub认证检查操作
github_auth_check_operation() {
    local check_type="${1:-status}"  # status/login/token
    
    # 验证GitHub CLI可用性
    if ! command -v gh >/dev/null 2>&1; then
        echo "❌ GitHub CLI (gh) 未安装" >&2
        return 1
    fi
    
    case "$check_type" in
        "status")
            # 检查认证状态
            if gh auth status >/dev/null 2>&1; then
                echo "✅ GitHub CLI 已认证"
                return 0
            else
                echo "❌ GitHub CLI 未认证" >&2
                return 1
            fi
            ;;
        "login")
            # 交互式登录
            echo "🔐 启动GitHub CLI登录流程..."
            gh auth login
            ;;
        "token")
            # 检查token有效性
            if gh auth token >/dev/null 2>&1; then
                echo "✅ GitHub token 有效"
                return 0
            else
                echo "❌ GitHub token 无效或已过期" >&2
                return 1
            fi
            ;;
        *)
            echo "❌ 错误：未知的检查类型: $check_type" >&2
            return 1
            ;;
    esac
}

# ==============================================================================
# GitHub操作查询原语
# ==============================================================================

# GitHub PR状态查询操作
github_pr_status_query() {
    local pr_number="$1"
    local worktree_path="${2:-$(pwd)}"
    local output_format="${3:-json}"  # json/table/text
    
    # 前置安全检查
    [[ -n "$pr_number" ]] || {
        echo "❌ 错误：PR编号不能为空" >&2
        return 1
    }
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    fi
    
    # 构造查询参数
    local view_args=("pr" "view" "$pr_number")
    
    case "$output_format" in
        "json")
            view_args+=("--json" "number,title,state,author,createdAt,updatedAt,url,head,base")
            ;;
        "table")
            # 默认表格格式
            ;;
        "text")
            view_args+=("--comments")
            ;;
        *)
            echo "❌ 错误：未知的输出格式: $output_format" >&2
            return 1
            ;;
    esac
    
    # 执行查询操作
    if gh -C "$worktree_path" "${view_args[@]}" 2>/dev/null; then
        return 0
    else
        echo "❌ 查询PR失败: #$pr_number" >&2
        return 1
    fi
}

# GitHub仓库信息查询操作
github_repo_info_query() {
    local worktree_path="${1:-$(pwd)}"
    local output_format="${2:-json}"
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    fi
    
    # 构造查询参数
    local repo_args=("repo" "view")
    
    case "$output_format" in
        "json")
            repo_args+=("--json" "name,owner,url,defaultBranch,visibility,description")
            ;;
        "table"|"text")
            # 默认格式
            ;;
        *)
            echo "❌ 错误：未知的输出格式: $output_format" >&2
            return 1
            ;;
    esac
    
    # 执行查询操作
    if gh -C "$worktree_path" "${repo_args[@]}" 2>/dev/null; then
        return 0
    else
        echo "❌ 查询仓库信息失败" >&2
        return 1
    fi
}

# ==============================================================================
# 辅助操作方法
# ==============================================================================

# 检查GitHub CLI可用性
github_check_cli_availability() {
    # 检查CLI安装
    if ! command -v gh >/dev/null 2>&1; then
        echo "❌ 错误：GitHub CLI (gh) 未安装" >&2
        echo "💡 安装方法: https://cli.github.com/" >&2
        return 1
    fi
    
    # 检查认证状态
    if ! gh auth status >/dev/null 2>&1; then
        echo "❌ 错误：GitHub CLI 未认证" >&2
        echo "💡 认证方法: gh auth login" >&2
        return 1
    fi
    
    return 0
}

# 验证PR编号格式
github_validate_pr_number() {
    local pr_number="$1"
    
    # 检查是否为正整数
    if [[ ! "$pr_number" =~ ^[1-9][0-9]*$ ]]; then
        echo "❌ 错误：无效的PR编号格式: $pr_number" >&2
        return 1
    fi
    
    return 0
}

# 检查PR是否存在
github_pr_exists_check() {
    local pr_number="$1"
    local worktree_path="${2:-$(pwd)}"
    
    # 验证PR编号格式
    github_validate_pr_number "$pr_number" || return 1
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 检查PR存在性
    if gh -C "$worktree_path" pr view "$pr_number" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# 获取用户GitHub信息
github_get_user_info() {
    local output_format="${1:-json}"
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    case "$output_format" in
        "json")
            gh api user --jq '{login: .login, name: .name, email: .email, company: .company}' 2>/dev/null || {
                echo "❌ 获取用户信息失败" >&2
                return 1
            }
            ;;
        "text")
            gh api user --template '{{.login}} ({{.name}})' 2>/dev/null || {
                echo "❌ 获取用户信息失败" >&2
                return 1
            }
            ;;
        *)
            echo "❌ 错误：未知的输出格式: $output_format" >&2
            return 1
            ;;
    esac
}

# 检查仓库权限
github_check_repo_permissions() {
    local worktree_path="${1:-$(pwd)}"
    local required_permission="${2:-write}"  # read/write/admin
    
    # 验证GitHub CLI可用性
    github_check_cli_availability || return 1
    
    # 验证工作目录
    [[ -d "$worktree_path" ]] || {
        echo "❌ 错误：工作树路径不存在: $worktree_path" >&2
        return 1
    fi
    
    # 获取仓库权限信息
    local permissions
    permissions=$(gh -C "$worktree_path" api repos/{owner}/{repo} --jq '.permissions' 2>/dev/null) || {
        echo "❌ 无法获取仓库权限信息" >&2
        return 1
    }
    
    # 检查所需权限
    case "$required_permission" in
        "read")
            local has_read
            has_read=$(echo "$permissions" | jq -r '.pull // false')
            [[ "$has_read" == "true" ]]
            ;;
        "write")
            local has_write
            has_write=$(echo "$permissions" | jq -r '.push // false')
            [[ "$has_write" == "true" ]]
            ;;
        "admin")
            local has_admin
            has_admin=$(echo "$permissions" | jq -r '.admin // false')
            [[ "$has_admin" == "true" ]]
            ;;
        *)
            echo "❌ 错误：未知的权限类型: $required_permission" >&2
            return 1
            ;;
    esac
}