#!/bin/bash

# NewGPF Pre-commit Hook
# 只控制worktree目录下的Epic分支，强制正确的开发流程

set -euo pipefail

# 颜色定义
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly BLUE='\033[0;34m'
readonly NC='\033[0m' # No Color

# 检查是否在worktree中
is_in_worktree() {
    local current_path="$PWD"
    [[ "$current_path" == *"/.worktrees/"* ]]
}

# 检查是否在GPF管理的环境中
is_gpf_managed() {
    # 检查是否是GPF项目（有bin/git-pr-flow）
    local project_root="$PWD"
    while [[ "$project_root" != "/" ]]; do
        if [[ -f "$project_root/bin/git-pr-flow" ]]; then
            return 0
        fi
        project_root="$(dirname "$project_root")"
    done
    return 1
}

# 获取当前分支名
get_current_branch() {
    git branch --show-current 2>/dev/null || git symbolic-ref --short HEAD 2>/dev/null || echo ""
}

# 检查是否是Epic分支（新GPF格式：以 -e 结尾，但不是 -ef 结尾）
is_epic_branch() {
    local branch_name="$1"
    if [[ "$branch_name" == *"-e" && "$branch_name" != *"-ef" ]]; then
        return 0
    fi
    return 1
}

# 检查Epic分支是否只提交了roadmap文件
check_epic_roadmap_only() {
    local current_branch="$1"
    
    # 获取此次提交涉及的文件
    local staged_files
    staged_files=$(git diff --cached --name-only)
    
    if [[ -z "$staged_files" ]]; then
        # 没有staged文件，允许
        return 0
    fi
    
    # 检查是否所有文件都是Epic roadmap文件
    local disallowed_files=""
    while IFS= read -r file; do
        if [[ -n "$file" ]]; then
            # 允许的文件：docs/epic_roadmap/ 目录下的相关文件
            if [[ "$file" == docs/epic_roadmap/* ]]; then
                continue  # 允许Epic roadmap文件
            fi
            # 其他文件不允许
            disallowed_files="$disallowed_files $file"
        fi
    done <<< "$staged_files"
    
    if [[ -n "$disallowed_files" ]]; then
        echo ""
        echo -e "${RED}🚫 GPF Policy: Epic分支只允许提交Epic roadmap文档${NC}"
        echo ""
        echo -e "${YELLOW}当前分支：${NC} $current_branch"
        echo -e "${YELLOW}分支类型：${NC} Epic分支（仅用于roadmap管理）"
        echo ""
        echo -e "${GREEN}✅ Epic分支允许提交的文件：${NC}"
        echo -e "  • docs/epic_roadmap/*.md (Epic路线图文档)"
        echo ""
        echo -e "${RED}❌ 不允许提交的文件：${NC}"
        for file in $disallowed_files; do
            echo -e "  • $file"
        done
        echo ""
        
        # 提取Epic名称用于建议
        local epic_name="${current_branch%-e}"
        if [[ "$epic_name" == epic-* ]]; then
            epic_name="${epic_name#epic-}"
        fi
        
        echo -e "${BLUE}💡 解决方案：${NC}"
        echo -e "${GREEN}1. 撤销当前暂存的修改：${NC}"
        echo -e "   git reset HEAD"
        echo ""
        echo -e "${GREEN}2. 创建Feature分支进行开发：${NC}"
        echo -e "   git checkout -b epic-${epic_name}-<feature-name>-ef"
        echo -e "   # 或使用GPF命令："
        echo -e "   gpf start -ef <feature-name> $epic_name"
        echo ""
        echo -e "${GREEN}3. 移动现有修改到Feature分支：${NC}"
        echo -e "   # 暂存当前修改"
        echo -e "   git stash push -m \"移动到feature分支\""
        echo -e "   # 切换到feature分支"
        echo -e "   git checkout epic-${epic_name}-<feature-name>-ef"
        echo -e "   # 应用修改"
        echo -e "   git stash pop"
        echo -e "   # 在feature分支提交"
        echo -e "   git add . && git commit -m \"实现功能\""
        echo ""
        echo -e "${BLUE}📋 GPF开发规则：${NC}"
        echo -e "  • ${GREEN}Epic分支 (${current_branch})${NC}：仅用于roadmap文档和整合Feature分支"
        echo -e "  • ${GREEN}Feature分支 (epic-${epic_name}-*-ef)${NC}：实际开发工作"
        echo -e "  • ${GREEN}工作流程${NC}：Feature开发 → Feature提交 → Feature PR到Epic → Epic整合"
        echo ""
        
        return 1
    fi
    
    # 所有文件都是roadmap文件，允许提交
    return 0
}

# 主要检查逻辑
main() {
    # 只在worktree中进行检查
    if ! is_in_worktree; then
        # 不在worktree中，不进行GPF检查
        exit 0
    fi
    
    # 只在GPF管理的项目中进行检查
    if ! is_gpf_managed; then
        # 非GPF项目，不干预
        exit 0
    fi
    
    local current_branch
    current_branch=$(get_current_branch)
    
    if [[ -z "$current_branch" ]]; then
        # 无法获取分支信息，允许提交
        exit 0
    fi
    
    # 检查是否在Epic分支上提交
    if is_epic_branch "$current_branch"; then
        # Epic分支，检查是否只提交roadmap文件
        if ! check_epic_roadmap_only "$current_branch"; then
            exit 1
        fi
        
        # 只提交roadmap文件，允许
        echo -e "${GREEN}✅ Epic roadmap文档提交已允许${NC}"
        exit 0
    fi
    
    # Feature分支或其他分支，正常允许
    exit 0
}

# 执行主逻辑
main "$@"