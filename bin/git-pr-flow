#!/usr/bin/env bash

# Git PR Flow - 高质量PR开发工具
# Version: 0.1.0-mvp
# Author: chatterzhao
# Description: 让每个开发者都能轻松产出高质量PR，享受并行开发的乐趣

set -euo pipefail

# 项目根目录
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 加载核心库
source "$PROJECT_ROOT/lib/utils/common.sh"
source "$PROJECT_ROOT/lib/utils/ui.sh"
source "$PROJECT_ROOT/lib/utils/git.sh"
source "$PROJECT_ROOT/lib/utils/config.sh"

# 版本信息
readonly VERSION="0.1.0-mvp"

# 显示帮助信息
show_help() {
    local format="${1:-text}"
    
    if [[ "$format" == "json" ]]; then
        show_help_json
        return 0
    fi
    
    cat << EOF
Git PR Flow - 高质量PR开发工具
AI友好的Epic级项目管理工具

语法:
    git-pr-flow <command> [args...] [options]

🔧 核心命令:
    init [epic-name]           初始化Epic开发环境
    start <epic/feature>       开始子功能开发 (自动分支切换)
    status [--json]            查看Epic进度仪表盘  
    sync [--dry-run]           智能同步依赖关系
    pr <epic/feature>          创建智能PR
    ready [epic-name]          Epic级策略性发布
    clean [--force]            清理工作环境
    code <epic/feature>        在VS Code中打开指定功能
    workspace [--epic <name>]  生成VS Code多Epic工作区

🔍 查询命令:
    help [command] [--json]    显示帮助信息
    version [--json]           显示版本信息

⚙️  全局选项:
    -h, --help                 显示帮助信息
    -v, --version              显示版本信息
    --debug                    启用调试模式
    --json                     JSON格式输出 (适合AI解析)

📋 参数格式:
    epic-name       ✓ 小写字母、数字、连字符 (如: user-auth, payment-api)
    epic/feature    ✓ Epic名/功能名格式 (如: auth/login, payment/checkout)

🤖 AI使用提示:
    • 所有命令支持非交互式模式，会自动选择合理默认值
    • 使用 --json 选项获取结构化输出，便于解析
    • 错误信息统一输出到stderr，便于分离正常输出
    • 退出码: 0=成功, 1=一般错误, 2=参数错误

📖 常用工作流:
    1. 初始化Epic:        git-pr-flow init my-epic
    2. 开始功能开发:      git-pr-flow start my-epic/feature-1
    3. 查看进度:          git-pr-flow status --json
    4. 创建PR:            git-pr-flow pr my-epic/feature-1
    5. Epic发布:          git-pr-flow ready my-epic

📚 获取详细帮助:
    git-pr-flow help <command>     # 命令详细说明
    git-pr-flow help --json        # JSON格式帮助信息

🔗 更多信息: https://github.com/chatterzhao/git-pr-flow
EOF
}

# JSON格式帮助信息 (AI友好)
show_help_json() {
    cat << 'EOF'
{
  "tool": {
    "name": "git-pr-flow",
    "version": "0.1.0-mvp",
    "description": "AI友好的Epic级高质量PR开发工具",
    "purpose": "让AI和开发者都能轻松管理复杂项目的并行开发"
  },
  "commands": {
    "init": {
      "syntax": "git-pr-flow init [epic-name]",
      "description": "初始化Epic开发环境", 
      "parameters": {
        "epic-name": {
          "type": "string",
          "required": false,
          "pattern": "^[a-z0-9-]+$",
          "description": "Epic名称，支持小写字母、数字、连字符"
        }
      },
      "non_interactive": true,
      "ai_usage": "自动选择合理的基础分支和默认配置"
    },
    "start": {
      "syntax": "git-pr-flow start <epic/feature>",
      "description": "开始子功能开发，创建worktree和分支",
      "parameters": {
        "epic/feature": {
          "type": "string", 
          "required": true,
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
          "example": "auth/login",
          "description": "功能分支名，格式: epic名/功能名"
        }
      },
      "features": ["自动分支切换", "worktree管理", "依赖检测"],
      "non_interactive": true
    },
    "status": {
      "syntax": "git-pr-flow status [--json]",
      "description": "查看Epic进度仪表盘",
      "options": {
        "--json": "输出JSON格式，便于AI解析"
      },
      "output_format": ["text", "json"],
      "non_interactive": true
    },
    "help": {
      "syntax": "git-pr-flow help [command] [--json]",
      "description": "显示帮助信息",
      "options": {
        "--json": "JSON格式输出",
        "command": "特定命令的详细帮助"
      }
    }
  },
  "workflow": {
    "typical_usage": [
      "git-pr-flow init my-epic",
      "git-pr-flow start my-epic/feature-1", 
      "git-pr-flow status --json",
      "git-pr-flow pr my-epic/feature-1",
      "git-pr-flow ready my-epic"
    ],
    "ai_friendly_features": [
      "非交互式模式支持",
      "JSON格式输出",
      "结构化错误信息", 
      "一致的退出码",
      "自动选择默认值"
    ]
  },
  "global_options": {
    "--json": "JSON格式输出 (推荐AI使用)",
    "--debug": "启用调试信息输出到stderr",
    "--help": "显示帮助信息",
    "--version": "显示版本信息"
  },
  "exit_codes": {
    "0": "成功",
    "1": "一般错误",
    "2": "参数错误",
    "3": "环境错误 (如不在Git仓库中)"
  },
  "ai_best_practices": {
    "output_parsing": "使用--json选项获取结构化输出",
    "error_handling": "检查退出码和stderr输出",
    "batch_operations": "命令支持非交互式批量执行",
    "state_management": "通过status命令了解当前状态"
  }
}
EOF
}

# 显示版本信息
show_version() {
    echo "Git PR Flow v$VERSION"
    echo "高质量PR开发工具 - MVP版本"
    echo "设计理念: 零心智负担的并行开发"
}

# 主函数
main() {
    # 解析全局选项
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --debug)
                export GIT_PR_DEBUG=1
                shift
                ;;
            -*)
                ui_error "未知选项: $1"
                show_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # 检查Git环境
    if ! git_check_environment; then
        ui_error "请在Git仓库中运行此命令"
        exit 1
    fi

    # 执行命令
    local command="${1:-}"
    
    if [[ -z "$command" ]]; then
        show_help
        exit 0
    fi

    case "$command" in
        init)
            shift
            source "$PROJECT_ROOT/lib/commands/init.sh"
            cmd_init "$@"
            ;;
        start)
            shift
            source "$PROJECT_ROOT/lib/commands/start.sh"
            cmd_start "$@"
            ;;
        status)
            shift
            source "$PROJECT_ROOT/lib/commands/status.sh"
            cmd_status "$@"
            ;;
        sync)
            shift
            source "$PROJECT_ROOT/lib/commands/sync.sh"
            cmd_sync "$@"
            ;;
        pr)
            shift
            source "$PROJECT_ROOT/lib/commands/pr.sh"
            cmd_pr "$@"
            ;;
        ready)
            shift
            source "$PROJECT_ROOT/lib/commands/ready.sh"
            cmd_ready "$@"
            ;;
        clean)
            shift
            source "$PROJECT_ROOT/lib/commands/clean.sh"
            cmd_clean "$@"
            ;;
        code)
            shift
            source "$PROJECT_ROOT/lib/commands/code.sh"
            cmd_code "$@"
            ;;
        workspace)
            shift
            source "$PROJECT_ROOT/lib/commands/workspace.sh"
            cmd_workspace "$@"
            ;;
        help)
            shift
            # 解析help命令的选项
            local help_format="text"
            while [[ $# -gt 0 ]]; do
                case $1 in
                    --json)
                        help_format="json"
                        shift
                        ;;
                    *)
                        # TODO: 实现特定命令的详细帮助
                        ui_error "暂不支持特定命令帮助: $1"
                        shift
                        ;;
                esac
            done
            show_help "$help_format"
            ;;
        *)
            ui_error "未知命令: $command"
            show_help
            exit 1
            ;;
    esac
}

# 错误处理
trap 'handle_error $? $LINENO' ERR

handle_error() {
    local exit_code=$1
    local line_number=$2
    
    if [[ $exit_code -ne 0 ]]; then
        ui_error "命令执行失败 (退出码: $exit_code, 行号: $line_number)"
        if [[ "${GIT_PR_DEBUG:-}" == "1" ]]; then
            echo "调试信息: 可能的原因包括Git环境异常、权限问题或配置错误" >&2
        fi
    fi
    
    exit $exit_code
}

# 运行主函数
main "$@"