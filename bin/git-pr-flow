#!/usr/bin/env bash

# Git PR Flow - 高质量PR开发工具
# Version: 0.1.0-mvp
# Author: chatterzhao
# Description: 让每个开发者都能轻松产出高质量PR，享受并行开发的乐趣

set -euo pipefail

# 项目根目录
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 加载核心库
source "$PROJECT_ROOT/lib/utils/common.sh"
source "$PROJECT_ROOT/lib/utils/ui.sh"
source "$PROJECT_ROOT/lib/utils/git.sh"
source "$PROJECT_ROOT/lib/utils/config.sh"

# 版本信息
readonly VERSION="0.1.0-mvp"

# 显示帮助信息
show_help() {
    cat << EOF
Git PR Flow - 让复杂项目自然产出高质量PR

目的: 解决大功能开发中的PR质量问题
- 功能太大无法拆分，导致巨型PR难审查
- 多个子功能相互依赖，提交时机难控制  
- 分支切换频繁，开发上下文经常丢失

解决方案: Epic三层架构 + 并行工作树
- Epic作为功能集合，子功能独立开发
- 每个功能有独立工作环境，避免切换
- 智能依赖管理，控制PR提交时机

术语定义：
epic或epic-name: 功能集合，如：user-auth
epic-name/feature: 子功能，如：user-auth/login
epic/epic-name分支: Epic集成git分支，如：epic/user-auth（特殊分支命名，worktree目录名不需要“epic/”部分）
epic-name/feature分支: 子功能Git分支，如：user-auth/login (注意：不含epic/前缀，避免Git引用冲突)

基本使用流程:
  # 1. 创建Epic，这里示例是：user-auth  
  gpf init user-auth develop   # 初始化用户认证系统开发
  # 效果: 
  # 会同时使用 git worktree 在根目录下创建 .worktrees/epic--user-auth/ 目录
  # yaml 配置文件;
  # 以及创建 epic/user-auth 分支 （自动补epic/）

  # 2. 开发子功能
  gpf start user-auth/login
  # 效果: 
  # 会同时使用 git worktree在根目录下创建 .worktrees/epic--user-auth--login/ （与epic--user-auth 目录并列，注意不是包含）；
  # 还会创建git 分支 user-auth/login（注意：不含epic/前缀，避免与epic/user-auth冲突）

  # 3. 开发到一定阶段，为子功能创建PR
  gpf ready user-auth/login    # 🚪 质量门禁：子功能就绪检查
  gpf pr user-auth/login       # 子功能 → Epic PR(这里的 Epic 是 epic/user-auth 分支)
  # 效果: 子功能 → Epic分支的PR

  # 4. 子功能清理 (合并到Epic后)
  gpf clean user-auth/login
  # → 检查是否已合并到Epic分支
  # → 提示: "子功能 user-auth/login 已合并到 epic/user-auth，清理工作树成功"

  # 5. Epic所有子功能完成后
  gpf ready user-auth      # 🚪 质量门禁：Epic就绪检查  
  gpf pr epic/user-auth    # Epic分支 → 主分支的PR
  # 效果: Epic分支 → 主分支的PR

  # 6. Epic清理 (合并到主分支后) 
  gpf clean user-auth
  # → 检查是否已合并到主分支
  # → 提示: "Epic epic/user-auth 已合并到 develop，清理整个Epic工作树成功"

命令说明:
    init <epic-name>          创建Epic开发环境 (工作树+分支+配置)
    start <epic-name/feature> 开始子功能开发 (创建独立工作树和分支)
    ready <target>           质量门禁检查 (target可以是子功能或Epic)
    pr <target>              创建PR (子功能→Epic 或 Epic→主分支)
    status                   显示Epic进度和分支状态
    clean <target>           清理已合并的工作树和分支

特点:
- 非交互式友好，AI和脚本可直接调用
- 自动选择合理默认值，减少决策负担
- 清晰的状态反馈，便于理解执行结果

⚠️  工作流保护机制:
GPF安装时会配置Git hooks来保护工作流完整性：

🚫 禁止的提交操作:
  - 在项目根目录的主分支(develop/main/master)上直接提交
  - 在Epic分支(epic/xx)上直接开发和提交
  
✅ 推荐的开发流程:
  - 使用 'gpf start xx/yy' 创建功能分支进行开发
  - 在功能分支(.worktrees/xx--yy/)中正常提交
  
🔧 如需强制提交(紧急情况):
  方法1: GPF_FORCE_COMMIT=1 git commit -m "紧急修复"
  方法2: git commit -m "紧急修复 GPF_FORCE_COMMIT"
  
  ⚠️  强制提交会跳过工作流保护，请谨慎使用！

参数格式:
  epic-name: 小写字母数字连字符 (如: user-auth, payment-api)
  epic-name/feature: Epic名/功能名 (如: user-auth/login)

示例项目结构:
  .worktrees/epic--user-auth/           # Epic集成开发环境
  .worktrees/epic--user-auth--login/    # 登录子功能独立开发环境
  .worktrees/epic--user-auth--register/ # 注册子功能独立开发环境
  .worktrees/epic--payment--checkout/   # 支付功能独立开发环境

获取帮助: gpf --help (或 git-pr-flow --help)
版本信息: gpf --version (或 git-pr-flow --version)
EOF
}


# 显示版本信息
show_version() {
    echo "Git PR Flow v$VERSION"
    echo "高质量PR开发工具 - MVP版本"
    echo "设计理念: 零心智负担的并行开发"
}

# 主函数
main() {
    # 解析全局选项
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --debug)
                export GIT_PR_DEBUG=1
                shift
                ;;
            -*)
                ui_error "未知选项: $1"
                show_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # 检查Git环境
    if ! git_check_environment; then
        ui_error "请在Git仓库中运行此命令"
        exit 1
    fi

    # 执行命令
    local command="${1:-}"
    
    if [[ -z "$command" ]]; then
        show_help
        exit 0
    fi

    case "$command" in
        init)
            shift
            source "$PROJECT_ROOT/lib/commands/init.sh"
            cmd_init "$@"
            ;;
        start)
            shift
            source "$PROJECT_ROOT/lib/commands/start.sh"
            cmd_start "$@"
            ;;
        status)
            shift
            source "$PROJECT_ROOT/lib/commands/status.sh"
            cmd_status "$@"
            ;;
        sync)
            shift
            source "$PROJECT_ROOT/lib/commands/sync.sh"
            cmd_sync "$@"
            ;;
        pr)
            shift
            source "$PROJECT_ROOT/lib/commands/pr.sh"
            cmd_pr "$@"
            ;;
        ready)
            shift
            source "$PROJECT_ROOT/lib/commands/ready.sh"
            cmd_ready "$@"
            ;;
        clean)
            shift
            source "$PROJECT_ROOT/lib/commands/clean.sh"
            cmd_clean "$@"
            ;;
        code)
            shift
            source "$PROJECT_ROOT/lib/commands/code.sh"
            cmd_code "$@"
            ;;
        workspace)
            shift
            source "$PROJECT_ROOT/lib/commands/workspace.sh"
            cmd_workspace "$@"
            ;;
        help)
            show_help
            ;;
        *)
            ui_error "未知命令: $command"
            show_help
            exit 1
            ;;
    esac
}

# 错误处理
trap 'handle_error $? $LINENO' ERR

handle_error() {
    local exit_code=$1
    local line_number=$2
    
    if [[ $exit_code -ne 0 ]]; then
        ui_error "命令执行失败 (退出码: $exit_code, 行号: $line_number)"
        if [[ "${GIT_PR_DEBUG:-}" == "1" ]]; then
            echo "调试信息: 可能的原因包括Git环境异常、权限问题或配置错误" >&2
        fi
    fi
    
    exit $exit_code
}

# 运行主函数
main "$@"