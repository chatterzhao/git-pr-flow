#!/bin/bash

# GPF Main Entry Point
set -euo pipefail

# 显示帮助信息的函数
show_help() {
    echo "GPF v2.0.0 - Git PR Flow CLI Tool"
    echo ""
    echo "Usage: gpf <command> [options]"
    echo ""
    echo "Commands:"
    echo "  start   Create Epic or Feature branch"
    echo "  pr      Create pull request" 
    echo "  status  Show current status"
    echo "  clean   Clean up branches"
    echo "  sync    Sync branches"
    echo ""
    echo "Options:"
    echo "  --help     Show this help message"
    echo "  --version  Show version information"
    echo ""
}

case "${1:-}" in
    --version|-v)
        echo "GPF v2.0.0"
        ;;
    --help|-h|"")
        show_help
        ;;
    status)
        # 获取脚本所在目录
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        # 调用status命令，传递除第一个参数外的所有参数
        shift
        bash "$SCRIPT_DIR/../lib/commands/status.sh" "$@"
        ;;
    *)
        echo "❌ 错误：未知命令 '$1'"
        echo ""
        show_help
        exit 1
        ;;
esac