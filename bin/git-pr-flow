#!/usr/bin/env bash

# Git PR Flow - 高质量PR开发工具
# Version: 0.1.0-mvp
# Author: chatterzhao
# Description: 让每个开发者都能轻松产出高质量PR，享受并行开发的乐趣

set -euo pipefail

# 项目根目录
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 加载核心库
source "$PROJECT_ROOT/lib/utils/common.sh"
source "$PROJECT_ROOT/lib/utils/ui.sh"
source "$PROJECT_ROOT/lib/utils/git.sh"
source "$PROJECT_ROOT/lib/utils/config.sh"

# 版本信息
readonly VERSION="0.1.0-mvp"

# 显示帮助信息
show_help() {
    cat << EOF
Git PR Flow - 让复杂项目自然产出高质量PR

目的: 解决大功能开发中的PR质量问题
- 功能太大无法拆分，导致巨型PR难审查
- 多个子功能相互依赖，提交时机难控制  
- 分支切换频繁，开发上下文经常丢失

解决方案: Epic三层架构 + 并行工作树
- Epic作为功能集合，子功能独立开发
- 每个功能有独立工作环境，避免切换
- 智能依赖管理，控制PR提交时机

基本使用流程:
  1. 初始化Epic: git-pr-flow init user-auth
  2. 开发子功能:   git-pr-flow start user-auth/login  
  3. 查看进度:     git-pr-flow status
  4. 提交PR:      git-pr-flow pr user-auth/login
  5. Epic发布:    git-pr-flow ready user-auth

命令说明:
  init <epic-name>      创建Epic开发环境和配置
  start <epic/feature>  开始子功能开发，创建独立工作树
  status               显示Epic进度和分支状态
  pr <epic/feature>    为子功能创建PR
  ready <epic-name>    Epic完成，准备发布
  clean                清理已合并的分支和工作树

特点:
- 非交互式友好，AI和脚本可直接调用
- 自动选择合理默认值，减少决策负担
- 清晰的状态反馈，便于理解执行结果

参数格式:
  epic-name: 小写字母数字连字符 (如: user-auth, payment-api)
  epic/feature: Epic名/功能名 (如: user-auth/login)

示例项目结构:
  .worktrees/user-auth--login/     # 登录功能独立开发环境
  .worktrees/user-auth--register/  # 注册功能独立开发环境
  .worktrees/payment--checkout/    # 支付功能独立开发环境

获取帮助: git-pr-flow help
版本信息: git-pr-flow --version
EOF
}


# 显示版本信息
show_version() {
    echo "Git PR Flow v$VERSION"
    echo "高质量PR开发工具 - MVP版本"
    echo "设计理念: 零心智负担的并行开发"
}

# 主函数
main() {
    # 解析全局选项
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--version)
                show_version
                exit 0
                ;;
            --debug)
                export GIT_PR_DEBUG=1
                shift
                ;;
            -*)
                ui_error "未知选项: $1"
                show_help
                exit 1
                ;;
            *)
                break
                ;;
        esac
    done

    # 检查Git环境
    if ! git_check_environment; then
        ui_error "请在Git仓库中运行此命令"
        exit 1
    fi

    # 执行命令
    local command="${1:-}"
    
    if [[ -z "$command" ]]; then
        show_help
        exit 0
    fi

    case "$command" in
        init)
            shift
            source "$PROJECT_ROOT/lib/commands/init.sh"
            cmd_init "$@"
            ;;
        start)
            shift
            source "$PROJECT_ROOT/lib/commands/start.sh"
            cmd_start "$@"
            ;;
        status)
            shift
            source "$PROJECT_ROOT/lib/commands/status.sh"
            cmd_status "$@"
            ;;
        sync)
            shift
            source "$PROJECT_ROOT/lib/commands/sync.sh"
            cmd_sync "$@"
            ;;
        pr)
            shift
            source "$PROJECT_ROOT/lib/commands/pr.sh"
            cmd_pr "$@"
            ;;
        ready)
            shift
            source "$PROJECT_ROOT/lib/commands/ready.sh"
            cmd_ready "$@"
            ;;
        clean)
            shift
            source "$PROJECT_ROOT/lib/commands/clean.sh"
            cmd_clean "$@"
            ;;
        code)
            shift
            source "$PROJECT_ROOT/lib/commands/code.sh"
            cmd_code "$@"
            ;;
        workspace)
            shift
            source "$PROJECT_ROOT/lib/commands/workspace.sh"
            cmd_workspace "$@"
            ;;
        help)
            show_help
            ;;
        *)
            ui_error "未知命令: $command"
            show_help
            exit 1
            ;;
    esac
}

# 错误处理
trap 'handle_error $? $LINENO' ERR

handle_error() {
    local exit_code=$1
    local line_number=$2
    
    if [[ $exit_code -ne 0 ]]; then
        ui_error "命令执行失败 (退出码: $exit_code, 行号: $line_number)"
        if [[ "${GIT_PR_DEBUG:-}" == "1" ]]; then
            echo "调试信息: 可能的原因包括Git环境异常、权限问题或配置错误" >&2
        fi
    fi
    
    exit $exit_code
}

# 运行主函数
main "$@"